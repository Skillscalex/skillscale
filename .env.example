# Skillscale deployment environment
# Copy to .env.local for local development. Never commit real secrets.

# Public Supabase config. These values are safe to expose in browser bundles when RLS is correct.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Supabase key. Required for ingestion/mirror writes and admin sync.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin guard for ingestion endpoints and scheduled jobs.
INGEST_ADMIN_TOKEN=generate-a-long-random-token
CRON_SECRET=generate-a-long-random-token-for-vercel-cron

# AI providers for audit/studio routes.
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=

# Stripe marketplace payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live Studio agent WebSocket endpoint.
NEXT_PUBLIC_AGENTS_WS_URL=wss://agents.skillscale.ai
WS_PORT=3001

# Catalog ingestion sources.
SKILLS_SH_BEARER_TOKEN=

# Optional video/agent production stack.
ELEVENLABS_API_KEY=
TAVILY_API_KEY=
PEXELS_API_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=skillscale-videos
